#!/bin/bash

# Checks required to prevent code execution / privilege escalation
local run_script=0
local settings_path=""
if [[ -f "/home/${USER}/.psdoom-ng/psdoom-ng.conf" ]]; then
	settings_path="/home/${USER}/.psdoom-ng/psdoom-ng.conf"
elif [[ -f "/etc/psdoom-ng.conf" ]]; then
	settings_path="/etc/psdoom-ng.conf"
fi

if [[ -n "${settings_path}" ]]; then
	if [[ -n "${DISPLAY}" ]] && which zenity ; then
		zenity --question --title="psdoom-ng security settings check" --text=""$(cat "${settings_path}")"\n\nAre these settings safe?"
		if (( ${?} == 0 )) ; then
			source "${settings_path}"
		fi
	else
		echo
		echo "psdoom-ng security settings check"
		echo
		echo "Contents of ${settings_path}:"
		echo
		cat "${filepath}"
		echo
		echo "Are these settings safe? (y/N)"
		read -r run_script
		if [[ "${run_script}" =~ ("Y"|"y"|"1") ]] ; then
			source "${settings_path}"
		fi
	fi
fi

if [[ ! -v PSDOOMPSCMD || -z "${PSDOOMPSCMD}"  ]] ; then
	unset PSDOOMPSCMD
else
	export PSDOOMPSCMD="${PSDOOMPSCMD}"
fi
if [[ ! -v PSDOOMRENICECMD || -z "${PSDOOMRENICECMD}" ]] ; then
	unset PSDOOMRENICECMD
else
	export PSDOOMRENICECMD="${PSDOOMRENICECMD}"
fi
if [[ ! -v PSDOOMKILLCMD || -z "${PSDOOMKILLCMD}" ]] ; then
	unset PSDOOMKILLCMD
else
	export PSDOOMKILLCMD="${PSDOOMKILLCMD}"
fi
if [[ ! -v DOOMWADPATH || -z "${DOOMWADPATH}" ]] ; then
	unset DOOMWADPATH
else
	export DOOMWADPATH="${DOOMWADPATH}"
fi
echo "PSDOOMPSCMD=${PSDOOMPSCMD}"
echo "PSDOOMRENICECMD=${PSDOOMRENICECMD}"
echo "PSDOOMKILLCMD=${PSDOOMKILLCMD}"
echo "DOOMWADPATH=${DOOMWADPATH}"
/usr/bin/psdoom-ng ${DEFAULT_ARGS} "$@"
